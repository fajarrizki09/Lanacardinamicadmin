modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "gobject-introspection", "gtk3", "libxcrypt", "pkg-config", "qhull", "tcl", "tk", "libxkbcommon", "xorg.libX11", "xorg.libXrender", "xorg.libXext", "mesa", "xcb-util-cursor"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test Imports"

[[workflows.workflow]]
name = "Test Imports"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python test_imports.py"

[workflows.workflow.metadata]
outputType = "console"
