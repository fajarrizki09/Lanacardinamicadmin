modules = ["python-3.11"]
[agent]
expertMode = true

[nix]
channel = "stable-25_05"
packages = ["cairo", "ffmpeg-full", "freetype", "ghostscript", "glibcLocales", "gobject-introspection", "gtk3", "libxcrypt", "libxkbcommon", "mesa", "pkg-config", "qhull", "tcl", "tk", "xcb-util-cursor", "xorg.libX11", "xorg.libXext", "xorg.libXrender"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Test Imports"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "FastAPI Server Header"

[[workflows.workflow]]
name = "Test Imports"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python test_imports.py"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "FastAPI Server Header"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uvicorn api.main:app --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
