{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lancar Dynamic Admin",
  "version": "1.7.50",
  "identifier": "com.lancardynamic.admin",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lancar Dynamic Admin - Aplikasi Klinik",
        "url": "index.html",
        "width": 1280,
        "height": 720,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "../icon.ico"
    ],
    "externalBin": [
      "binaries/lancar-api"
    ],
    "resources": [
      "runtime/openwa_server/",
      "runtime/node/"
    ]
  }
}
